<Window x:Class="floder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncApp" Height="520" Width="400">

    <StackPanel Margin="10">

        <Button Click="BtnSelectFolder_Click">
            Выбрать папку
        </Button>

        <Button Click="BtnConnect_Click">
            Подключиться к серверу
        </Button>

        <Button Click="BtnSendIndex_Click">
            Отправить индекс
        </Button>

        <ListBox Name="FilesList"/>

    </StackPanel>
</Window>